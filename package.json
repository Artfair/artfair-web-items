{
  "name": "@artfair/web-items",
  "version": "1.7.0",
  "description": "Geteiltes Design-Regal fuer Messe-Websites — Item-Bauteile, SectionRenderer, Theme (Tailwind-Preset + Tokens + Fonts). Die Markenfarben kommen aus CSS-Variablen, die jede Instanz selbst setzt.",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./griffe": "./src/lib/griffe.ts",
    "./tailwind-preset": "./tailwind-preset.cjs",
    "./styles/tokens.css": "./src/styles/tokens.css",
    "./styles/magazine.css": "./src/styles/magazine.css"
  },
  "files": [
    "src",
    "tailwind-preset.cjs",
    "tailwind-preset.d.cts"
  ],
  "peerDependencies": {
    "next": ">=14",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "typescript": "^5"
  }
